# Sucuk-Agent Ortam Değişkenleri
# Bu değerleri Vercel > Project > Settings > Environment Variables ve
# GitHub Secrets olarak ekleyin. Gerçek anahtarlar repoya asla işlenmez.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google (Gemini) API anahtarları (3 adet) ---
GOOGLE_API_KEY_1=
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=

# --- OpenAI API anahtarları (3 adet) ---
OPENAI_API_KEY_1=
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=

# --- Groq API anahtarları (3 adet) ---
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# --- Grok (xAI) API anahtarları (3 adet) ---
GROK_API_KEY_1=
GROK_API_KEY_2=
GROK_API_KEY_3=

# --- OpenRouter API anahtarları (3 adet) ---
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=

# --- DeepSeek API anahtarları (3 adet) ---
DEEPSEEK_API_KEY_1=
DEEPSEEK_API_KEY_2=
DEEPSEEK_API_KEY_3=

# --- KIMI (Moonshot) API anahtarları (3 adet) ---
KIMI_API_KEY_1=
KIMI_API_KEY_2=
KIMI_API_KEY_3=

# --- Nvidia API anahtarları (3 adet) ---
NVIDIA_API_KEY_1=
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=

# --- Hugging Face (görsel üretim / model desteği) ---
HUGGINGFACE_API_TOKEN=

# --- Web arama (DuckDuckGo HTML sunucu tarafı, anahtar gerektirmez) ---

# Oturum güvenlik anahtarı (çerez imzalama için)
SESSION_SECRET=geliştirme-modunda-degistirin

# Varsayılan hesaplar (sadece sign-in, kayıt panel yok)
ADMIN_USERNAME=Sucuk9977
ADMIN_PASSWORD=SigmaAkif2013
